rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Portfolio Images/Assets
    // Public Read, Admin Write
    match /portfolio/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
